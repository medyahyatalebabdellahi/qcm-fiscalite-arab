    // =================== QUESTIONS INSPECTEUR (180 en mélange) ===================
    const inspecteurQuestions = [
      ...controleurQuestions.slice(0, 80),
      q('ينتج الربح المحاسبي عن:',
        ['الإيرادات - المصروفات', 'الديون - النقدية', 'الأصول الثابتة - رأس المال', 'الأصول - المبيعات'], 0),
      q('الأصل الثابت هو:',
        ['أصل مخصص للاستخدام الدائم', 'ضريبة', 'غرامة', 'دين قصير الأجل'], 0),
      q('التضخم يعني:',
        ['ارتفاع عام ومستدام في الأسعار', 'ارتفاع الصادرات', 'انخفاض الضرائب', 'ارتفاع سعر منتج واحد'], 0),
      q('ميزانية الدولة تعكس:',
        ['الإيرادات والنفقات العامة المخطط لها', 'الحسابات الشخصية', 'أرباح البنوك', 'مبيعات الأسر'], 0),
      q('ضريبة القيمة المضافة هي ضريبة:',
        ['مباشرة', 'غير مباشرة', 'على الثروة', 'طوعية'], 1),
      q('الدين يشكل:',
        ['التزام تجاه الغير', 'إيراد ضريبي', 'ربح', 'منتج'], 0),
      q('الرقابة الداخلية تهدف إلى:',
        ['تقليل مخاطر الأخطاء والاحتيال', 'إنشاء النقود', 'إلغاء المحاسبة', 'تحديد الأسعار'], 0),
      q('تستخدم الميزانية المحاسبية للتحقق من:',
        ['توازن المدين والدائن', 'استبدال الميزانية العمومية', 'احتساب ضريبة القيمة المضافة', 'تحديد الحد الأدنى للأجور'], 0),
      q('مبدأ شرعية الضريبة:',
        ['تحدد الضريبة بموجب القانون', 'يختار المكلف معدله', 'يحدد المفتش ضريبة بحرية', 'يحدد البنك الضريبة'], 0),
      q('معدل الضريبة على الدخل:',
        ['5%', '10%', '15%', '20%'], 1),
      q('ضريبة التكوين المهني:',
        ['0.6%', '1%', '2%', '5%'], 0),
      q('الضريبة على العمليات المالية:',
        ['10%', '14%', '16%', '18%'], 1),
      q('الاقتطاع من المصدر على خدمات غير المقيمين:',
        ['10%', '15%', '20%', '25%'], 1),
      q('الاقتطاع من المصدر على خدمات المقيمين (الحرّيين):',
        ['1%', '2%', '2.5%', '5%'], 2),
      q('مدونة الاستثمار 2025 (رقم القانون):',
        ['2024-030', '2025-006', '2024-037', '2022-037'], 1),
      q('عدد الأنظمة التفضيلية في مدونة الاستثمار:',
        ['2', '3', '4', '5'], 1),
      q('يتضمن RIB الفئات:',
        ['المؤسسات الصغيرة والمتوسطة والمتوسطة', 'كبيرة وصغيرة', 'وطنية وأجنبية', 'زراعية وصناعية'], 0),
      q('استثمار الفئة المتوسطة في RIB:',
        ['2-30 مليون', '30-200 مليون', '200-500 مليون', '>500 مليون'], 1),
      q('وظائف الفئة المتوسطة في RIB:',
        ['5', '10', '15', '20'], 2),
      q('الرسوم الجمركية للفئة المتوسطة في RIB:',
        ['2%', '3%', '5%', '10%'], 2),
      q('ضريبة القيمة المضافة المخفضة للفئة المتوسطة في RIB:',
        ['5%', '10%', '15%', '16%'], 1),
      q('يتم إنشاء RPD بموجب:',
        ['قرار من المكلف', 'مرسوم من مجلس الوزراء', 'عقد شفهي', 'فاتورة'], 1),
      q('الحد الأدنى للاستثمار في RPD:',
        ['1 مليون', '2 مليون', '5 ملايين', '10 ملايين'], 1),
      q('الحد الأدنى لعدد الوظائف في RPD:',
        ['3', '5', '10', '15'], 1),
      q('معدل الضريبة على الشركات في RPD:',
        ['10%', '12%', '15%', '25%'], 2),
      q('ميزة التكوين في RPD:',
        ['50% بحد أقصى 100,000', '70% بحد أقصى 400,000', '80% بدون حد', '100% بحد أقصى 200,000'], 1),
      q('الحد الأدنى للاستثمار في RIS:',
        ['100 مليون', '200 مليون', '500 مليون', '30 مليون'], 1),
      q('الحد الأدنى لعدد الوظائف في RIS:',
        ['20', '30', '50', '100'], 2),
      q('الرسوم الجمركية في RIS:',
        ['0%', '1%', '1.5%', '3%'], 2),
      q('ميزة التكوين في RIS:',
        ['50% بحد أقصى 400,000', '70% بحد أقصى 800,000', '80% بدون حد', '100% بحد أقصى 200,000'], 1),
      q('الإهلاك المتسارع في RIS:',
        ['10%', '15%', '20%', '25%'], 3),
      q('الرسوم السنوية للمنطقة الحرة:',
        ['0.1%', '0.5%', '1%', '2%'], 1),
      q('حرية الصرف في المنطقة الحرة:',
        ['ممنوعة', 'جزئية', 'كاملة', 'مخصصة للبنوك'], 2),
      q('مدة الموافقة على المنطقة الحرة:',
        ['10 سنوات', '15 سنة', '20 سنة', '25 سنة'], 1),
      q('تمديد المنطقة الحرة:',
        ['5 سنوات', '10 سنوات', '15 سنة', '20 سنة'], 1),
      q('قانون الهيدروجين الأخضر:',
        ['2020-019', '2022-037', '2024-037', '2025-006'], 2),
      q('مدة الاتفاقية الإطارية للهيدروجين:',
        ['سنة واحدة', 'سنتان', '3 سنوات', '5 سنوات'], 1),
      q('مدة الاتفاقية الشاملة للهيدروجين:',
        ['15 سنة', '25 سنة', '35 سنة', '50 سنة'], 2),
      q('معدل الضريبة على الشركات للهيدروجين (R ≤ 1):',
        ['10%', '15%', '20%', '25%'], 1),
      q('معدل الضريبة على الشركات للمقاولين من الباطن في الهيدروجين:',
        ['2% من رقم الأعمال', '4% من رقم الأعمال', '5% من رقم الأعمال', '10% من رقم الأعمال'], 1),
      q('الضريبة على الدخل للهيدروجين:',
        ['2%', '3%', '4%', '5%'], 2),
      q('الاقتطاع من غير المقيمين للهيدروجين:',
        ['2%', '3%', '4%', '5%'], 2),
      q('الرسوم الجمركية للهيدروجين:',
        ['2%', '3%', '4%', '5%'], 2),
      q('الرسوم الجمركية المخفضة للهيدروجين:',
        ['1%', '2%', '3%', '4%'], 1),
      q('محاسبة الهيدروجين بالـ:',
        ['أوقية', 'يورو أو دولار', 'عملة محلية', 'أي عملة'], 1),
    ];

    const fullControleur = controleurQuestions.slice(0, 100);
    const fullInspecteur = inspecteurQuestions.slice(0, 100);

    // -------------------- ÉTAT DE L'APPLICATION --------------------
    let currentMode = 'controleur';
    let currentQuestions = [...fullControleur];
    let currentIndex = 0;
    let userAnswers = [];
    let questionStatus = [];
    let score = 0;
    let answered = false;

    const questionZone = document.getElementById('questionZone');
    const counterEl = document.getElementById('questionCounter');
    const scoreEl = document.getElementById('scoreDisplay');
    const progressFill = document.getElementById('progressFill');
    const nextBtn = document.getElementById('nextBtn');
    const resetBtn = document.getElementById('resetBtn');
    const resultBtn = document.getElementById('resultBtn');
    const modeControleur = document.getElementById('modeControleur');
    const modeInspecteur = document.getElementById('modeInspecteur');

    // -------------------- FONCTIONS UTILITAIRES --------------------
    function shuffleArray(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function initGame() {
      const pool = currentMode === 'controleur' ? [...fullControleur] : [...fullInspecteur];
      currentQuestions = shuffleArray(pool);
      currentIndex = 0;
      userAnswers = new Array(currentQuestions.length).fill(-1);
      questionStatus = new Array(currentQuestions.length).fill('unanswered');
      score = 0;
      answered = false;
      renderQuestion();
      updateInfo();
    }

    function updateInfo() {
      const total = currentQuestions.length;
      const num = currentIndex + 1;
      counterEl.innerHTML = `<i class="far fa-file-alt"></i> سؤال ${num} / ${total}`;
      const formattedScore = score.toFixed(2);
      scoreEl.innerHTML = `<i class="fas fa-star"></i> ${formattedScore} نقطة`;
      const progress = ((currentIndex + 1) / total) * 100;
      progressFill.style.width = progress + '%';
    }

    function renderQuestion() {
      if (currentIndex >= currentQuestions.length) {
        questionZone.innerHTML = `
          <div class="finish-message">
            <i class="fas fa-check-circle"></i>
            <h2>🎉 انتهى الاختبار!</h2>
            <p style="margin-top: 10px; font-size: 1.2rem;">نتيجتك: <strong>${score.toFixed(2)}</strong> نقطة</p>
            <p style="margin-top: 6px; color: #4b6589;">اضغط على "إعادة تعيين" للبدء من جديد</p>
          </div>
        `;
        nextBtn.disabled = true;
        updateInfo();
        return;
      }
      nextBtn.disabled = false;

      const q = currentQuestions[currentIndex];
      const letters = ['أ', 'ب', 'ج', 'د'];
      let html = `<div class="question-box"><div class="question-text">${q.question}</div><div class="options-grid">`;
      q.options.forEach((opt, idx) => {
        let extraClass = '';
        let iconHtml = '';
        const userChoice = userAnswers[currentIndex];
        if (answered && userChoice !== -1) {
          if (idx === q.correctIndex) {
            extraClass = 'selected-correct';
            iconHtml = `<i class="fas fa-check-circle icon-result" style="color:#16a34a;"></i>`;
          } else if (idx === userChoice && idx !== q.correctIndex) {
            extraClass = 'selected-wrong';
            iconHtml = `<i class="fas fa-times-circle icon-result" style="color:#dc2626;"></i>`;
          } else {
            extraClass = 'disabled-opt';
          }
        } else if (answered && userChoice === -1) {
          extraClass = 'disabled-opt';
          if (idx === q.correctIndex) {
            extraClass += ' selected-correct';
            iconHtml = `<i class="fas fa-check-circle icon-result" style="color:#16a34a;"></i>`;
          }
        }
        const disabledAttr = answered ? 'disabled-opt' : '';
        html += `
          <div class="option-item ${extraClass} ${disabledAttr}" data-optindex="${idx}" onclick="window.selectOption(${idx})">
            <span class="letter">${letters[idx]}.</span>
            <span class="text">${opt}</span>
            ${iconHtml}
          </div>
        `;
      });
      html += `</div></div>`;
      questionZone.innerHTML = html;
      updateInfo();
    }

    window.selectOption = function(optIndex) {
      if (answered) return;
      const q = currentQuestions[currentIndex];
      const isCorrect = (optIndex === q.correctIndex);
      userAnswers[currentIndex] = optIndex;
      if (isCorrect) {
        questionStatus[currentIndex] = 'correct';
        score += 0.125;
      } else {
        questionStatus[currentIndex] = 'wrong';
        score -= 0.25;
      }
      score = Math.round(score * 1000) / 1000;
      answered = true;
      renderQuestion();
    };

    function goToNext() {
      if (currentIndex < currentQuestions.length - 1) {
        currentIndex++;
        answered = false;
        renderQuestion();
        updateInfo();
      } else {
        currentIndex++;
        answered = true;
        renderQuestion();
        updateInfo();
      }
    }

    function resetGame() {
      const pool = currentMode === 'controleur' ? [...fullControleur] : [...fullInspecteur];
      currentQuestions = shuffleArray(pool);
      currentIndex = 0;
      userAnswers = new Array(currentQuestions.length).fill(-1);
      questionStatus = new Array(currentQuestions.length).fill('unanswered');
      score = 0;
      answered = false;
      nextBtn.disabled = false;
      renderQuestion();
      updateInfo();
    }

    function showResult() {
      let correctCount = 0;
      let wrongCount = 0;
      let unansweredCount = 0;
      for (let i = 0; i < questionStatus.length; i++) {
        if (questionStatus[i] === 'correct') correctCount++;
        else if (questionStatus[i] === 'wrong') wrongCount++;
        else unansweredCount++;
      }
      const total = currentQuestions.length;
      const percentage = ((correctCount / total) * 100).toFixed(1);
      alert(
        `📊 النتيجة التفصيلية\n\n` +
        `✅ الإجابات الصحيحة: ${correctCount}\n` +
        `❌ الإجابات الخاطئة: ${wrongCount}\n` +
        `⬜ غير مجاب عنها: ${unansweredCount}\n` +
        `📈 نسبة النجاح: ${percentage}%\n` +
        `⭐ النقاط: ${score.toFixed(2)}`
      );
    }

    function setMode(mode) {
      currentMode = mode;
      if (mode === 'controleur') {
        modeControleur.className = 'mode-btn active-controleur';
        modeInspecteur.className = 'mode-btn';
        document.getElementById('appContainer').style.borderLeft = '6px solid #6d28d9';
      } else {
        modeInspecteur.className = 'mode-btn active-inspecteur';
        modeControleur.className = 'mode-btn';
        document.getElementById('appContainer').style.borderLeft = '6px solid #0b6b9e';
      }
      resetGame();
    }

    // -------------------- ÉVÉNEMENTS --------------------
    nextBtn.addEventListener('click', goToNext);
    resetBtn.addEventListener('click', resetGame);
    resultBtn.addEventListener('click', showResult);
    modeControleur.addEventListener('click', function() { setMode('controleur'); });
    modeInspecteur.addEventListener('click', function() { setMode('inspecteur'); });

    // -------------------- LANCEMENT --------------------
    setMode('controleur');
  })();
</script>
