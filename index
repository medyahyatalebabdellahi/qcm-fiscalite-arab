   if(topic.classList.contains("open"))
      icon.textContent="−";
   else
      icon.textContent="＋";

 });

});


/* =====================================================
   OPEN ALL
===================================================== */

function openAll(){

 document.querySelectorAll(".topic")
 .forEach(topic=>{

   topic.classList.add("open");

   const icon=
    topic.querySelector(".topic-title span");

   if(icon)
      icon.textContent="−";

 });

}


/* =====================================================
   CLOSE ALL
===================================================== */

function closeAll(){

 document.querySelectorAll(".topic")
 .forEach(topic=>{

   topic.classList.remove("open");

   const icon=
    topic.querySelector(".topic-title span");

   if(icon)
      icon.textContent="＋";

 });

}


/* =====================================================
   SEARCH
===================================================== */

function searchTopics(){

 const text=
   document
    .getElementById("search")
    .value
    .toLowerCase()
    .trim();

 document
  .querySelectorAll(".topic")
  .forEach(topic=>{

    const content=
      topic.innerText
      .toLowerCase();

    if(
      text==="" ||
      content.includes(text)
    ){

      topic.classList.remove("hidden");

    }else{

      topic.classList.add("hidden");

    }

  });

}


/* =====================================================
   KEYBOARD SHORTCUT
===================================================== */

document.addEventListener("keydown",e=>{

 if(e.ctrlKey && e.key==="f"){

   e.preventDefault();

   document
    .getElementById("search")
    .focus();

 }

});

</script>

